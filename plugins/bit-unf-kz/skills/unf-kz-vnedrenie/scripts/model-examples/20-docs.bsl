// Модель: документы дня. Установка цен → приход коробками → перемещение в магазин штуками →
// оптовая накладная (вид цен из договора) → частичная оплата наличными → попытка продать больше остатка.
// Каждый шаг в своей Попытке: ошибка проведения — это результат проверки, его и пишем в лог.
Лог = "";
Орг = Справочники.Организации.Выбрать(); Орг.Следующий(); Орг = Орг.Ссылка;
Склад = Справочники.СтруктурныеЕдиницы.НайтиПоНаименованию("Модель склад");
Магазин = Справочники.СтруктурныеЕдиницы.НайтиПоНаименованию("Модель магазин");
Товар = Справочники.Номенклатура.НайтиПоНаименованию("Товар А");
Материал = Справочники.Номенклатура.НайтиПоНаименованию("Материал Б");
Шт = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию("шт");
Коробка = Справочники.ЕдиницыИзмерения.НайтиПоНаименованию("коробка (10 шт)", , , Товар);
Х1 = Справочники.ХарактеристикиНоменклатуры.НайтиПоНаименованию("Вариант 1", , , Товар);
ВЦОпт = Справочники.ВидыЦен.НайтиПоНаименованию("Модель опт");
ВЦРозн = Справочники.ВидыЦен.НайтиПоНаименованию("Модель розница");
Пост = Справочники.Контрагенты.НайтиПоНаименованию("Модель поставщик");
Покуп = Справочники.Контрагенты.НайтиПоНаименованию("Модель покупатель опт");
БезНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС");
Валюта = Константы.НациональнаяВалюта.Получить();
Д0 = НачалоДня(ТекущаяДатаСеанса());
ЗапросДоговора = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка, ВидЦен ИЗ Справочник.ДоговорыКонтрагентов ГДЕ Владелец = &В";

// 1. Цены: опт — за коробку, розница — за штуку (цена за коробку сама пересчитается в цену за штуку)
Попытка
	Д = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент(); Д.Заполнить(Неопределено); Д.Дата = Д0 + 8*3600;
	С = Д.Запасы.Добавить(); С.Номенклатура = Товар; С.Характеристика = Х1; С.ЕдиницаИзмерения = Коробка; С.ВидЦены = ВЦОпт; С.Цена = 9000; С.Валюта = ВЦОпт.ВалютаЦены;
	С = Д.Запасы.Добавить(); С.Номенклатура = Товар; С.Характеристика = Х1; С.ЕдиницаИзмерения = Шт; С.ВидЦены = ВЦРозн; С.Цена = 1200; С.Валюта = ВЦРозн.ВалютаЦены;
	С = Д.Запасы.Добавить(); С.Номенклатура = Материал; С.ЕдиницаИзмерения = Шт; С.ВидЦены = ВЦРозн; С.Цена = 300; С.Валюта = ВЦРозн.ВалютаЦены;
	Д.Записать(РежимЗаписиДокумента.Проведение); Лог = Лог + "1 Цены: проведено " + Д.Номер + Символы.ПС;
Исключение Лог = Лог + "1 Цены: ОШИБКА " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС; КонецПопытки;

// 2. Приход от поставщика: 3 коробки товара + материал штуками
Попытка
	Д = Документы.ПриходнаяНакладная.СоздатьДокумент(); Д.Дата = Д0 + 9*3600; Д.Заполнить(Неопределено);
	Д.ВидОперации = Перечисления.ВидыОперацийПриходнаяНакладная.ПоступлениеОтПоставщика;
	Д.Организация = Орг; Д.СтруктурнаяЕдиница = Склад; Д.Контрагент = Пост;
	З = Новый Запрос(ЗапросДоговора); З.УстановитьПараметр("В", Пост); Д.Договор = З.Выполнить().Выгрузить()[0].Ссылка;
	Д.ВалютаДокумента = Валюта; Д.Курс = 1; Д.Кратность = 1; Д.СуммаВключаетНДС = Истина;
	С = Д.Запасы.Добавить(); С.Номенклатура = Товар; С.Характеристика = Х1; С.ЕдиницаИзмерения = Коробка; С.Количество = 3; С.Цена = 7000;
	С = Д.Запасы.Добавить(); С.Номенклатура = Материал; С.ЕдиницаИзмерения = Шт; С.Количество = 20; С.Цена = 100;
	Для Каждого С Из Д.Запасы Цикл С.Сумма = С.Количество * С.Цена; С.Всего = С.Сумма; С.СтавкаНДС = БезНДС; КонецЦикла;
	Д.СуммаДокумента = Д.Запасы.Итог("Всего");
	Д.Записать(РежимЗаписиДокумента.Проведение); Лог = Лог + "2 Приход: проведено " + Д.Номер + " на " + Д.СуммаДокумента + Символы.ПС;
Исключение Лог = Лог + "2 Приход: ОШИБКА " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС; КонецПопытки;

// 3. Перемещение в магазин: 12 шт товара (часть коробки) и 10 шт материала
Попытка
	Д = Документы.ПеремещениеЗапасов.СоздатьДокумент(); Д.Дата = Д0 + 10*3600; Д.Заполнить(Неопределено);
	Д.ВидОперации = Перечисления.ВидыОперацийПеремещениеЗапасов.Перемещение;
	Д.Организация = Орг; Д.СтруктурнаяЕдиница = Склад; Д.СтруктурнаяЕдиницаПолучатель = Магазин;
	С = Д.Запасы.Добавить(); С.Номенклатура = Товар; С.Характеристика = Х1; С.ЕдиницаИзмерения = Шт; С.Количество = 12;
	С = Д.Запасы.Добавить(); С.Номенклатура = Материал; С.ЕдиницаИзмерения = Шт; С.Количество = 10;
	Д.Записать(РежимЗаписиДокумента.Проведение); Лог = Лог + "3 Перемещение: проведено " + Д.Номер + Символы.ПС;
Исключение Лог = Лог + "3 Перемещение: ОШИБКА " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС; КонецПопытки;

// 4. Оптовая накладная: 1 коробка, вид цен — из договора покупателя; 5. частичная оплата наличными
Попытка
	Д = Документы.РасходнаяНакладная.СоздатьДокумент(); Д.Дата = Д0 + 12*3600; Д.Заполнить(Неопределено);
	Д.ВидОперации = Перечисления.ВидыОперацийРасходнаяНакладная.ПродажаПокупателю;
	Д.Организация = Орг; Д.СтруктурнаяЕдиница = Склад; Д.Контрагент = Покуп;
	З = Новый Запрос(ЗапросДоговора); З.УстановитьПараметр("В", Покуп); ДД = З.Выполнить().Выгрузить()[0];
	Д.Договор = ДД.Ссылка; Д.ВидЦен = ДД.ВидЦен; Д.ВалютаДокумента = Валюта; Д.Курс = 1; Д.Кратность = 1; Д.СуммаВключаетНДС = Истина;
	С = Д.Запасы.Добавить(); С.Номенклатура = Товар; С.Характеристика = Х1; С.ЕдиницаИзмерения = Коробка; С.Количество = 1; С.Цена = 9000;
	Для Каждого С Из Д.Запасы Цикл С.Сумма = С.Количество * С.Цена; С.Всего = С.Сумма; С.СтавкаНДС = БезНДС; С.ТипНоменклатурыЗапас = Истина; КонецЦикла;
	Д.СуммаДокумента = Д.Запасы.Итог("Всего");
	Д.Записать(РежимЗаписиДокумента.Проведение); Накладная = Д.Ссылка;
	Лог = Лог + "4 Оптовая накладная: проведено " + Д.Номер + " на " + Д.СуммаДокумента + ", вид цен " + Д.ВидЦен + Символы.ПС;
	ПК = Документы.ПоступлениеВКассу.СоздатьДокумент(); ПК.Дата = Д0 + 12*3600 + 600; ПК.Заполнить(Накладная);
	ПК.СуммаДокумента = 5000; Для Каждого Р Из ПК.РасшифровкаПлатежа Цикл Р.СуммаПлатежа = 5000; Р.СуммаРасчетов = 5000; КонецЦикла;
	ПК.Записать(РежимЗаписиДокумента.Проведение); Лог = Лог + "5 Оплата наличными: проведено " + ПК.Номер + " на " + ПК.СуммаДокумента + Символы.ПС;
Исключение Лог = Лог + "4-5 ОШИБКА " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС; КонецПопытки;

// 6. Продать больше остатка: ожидаем отказ, если включён контроль остатков
Попытка
	Д = Документы.РасходнаяНакладная.СоздатьДокумент(); Д.Дата = Д0 + 13*3600; Д.Заполнить(Неопределено);
	Д.ВидОперации = Перечисления.ВидыОперацийРасходнаяНакладная.ПродажаПокупателю;
	Д.Организация = Орг; Д.СтруктурнаяЕдиница = Склад; Д.Контрагент = Покуп;
	З = Новый Запрос(ЗапросДоговора); З.УстановитьПараметр("В", Покуп); ДД = З.Выполнить().Выгрузить()[0];
	Д.Договор = ДД.Ссылка; Д.ВидЦен = ДД.ВидЦен; Д.ВалютаДокумента = Валюта; Д.Курс = 1; Д.Кратность = 1; Д.СуммаВключаетНДС = Истина;
	С = Д.Запасы.Добавить(); С.Номенклатура = Товар; С.Характеристика = Х1; С.ЕдиницаИзмерения = Коробка; С.Количество = 50; С.Цена = 9000;
	С.Сумма = 450000; С.Всего = 450000; С.СтавкаНДС = БезНДС; С.ТипНоменклатурыЗапас = Истина; Д.СуммаДокумента = 450000;
	Д.Записать(РежимЗаписиДокумента.Проведение);
	Лог = Лог + "6 ПРОВЕЛОСЬ без остатка (контроль остатков выключен?): " + Д.Номер + Символы.ПС;
Исключение
	Лог = Лог + "6 Не провелось без остатка (контроль работает): " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС;
КонецПопытки;

Для Каждого Сообщ Из ПолучитьСообщенияПользователю(Истина) Цикл Лог = Лог + "   сообщение: " + Сообщ.Текст + Символы.ПС; КонецЦикла;
Лог = Лог + "Контроль остатков при проведении: " + Константы.КонтролироватьОстаткиПриПроведении.Получить()
	+ ", при пробитии чека: " + Константы.КонтролироватьОстаткиПриПробитииЧековККМ.Получить() + Символы.ПС;
З = Новый Запрос("ВЫБРАТЬ Т.СтруктурнаяЕдиница КАК Склад, Т.Номенклатура КАК Н, Т.Характеристика КАК Х, Т.КоличествоОстаток КАК К ИЗ РегистрНакопления.Запасы.Остатки(, СтруктурнаяЕдиница В (&С)) КАК Т");
Склады = Новый Массив; Склады.Добавить(Склад); Склады.Добавить(Магазин); З.УстановитьПараметр("С", Склады);
Для Каждого С Из З.Выполнить().Выгрузить() Цикл Лог = Лог + "   остаток: " + С.Склад + " | " + С.Н + " " + С.Х + " = " + С.К + Символы.ПС; КонецЦикла;
Результат = Лог;
