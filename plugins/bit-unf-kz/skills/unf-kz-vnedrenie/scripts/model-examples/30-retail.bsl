// Модель: розничная смена. Способы оплаты (карта, QR) без оборудования, автономная касса ККМ магазина,
// отчёт о розничных продажах за смену: часть картой, часть по QR, остальное наличными.
// Чеки через РМК без подключённой онлайн-кассы не пробить — смену в модели закрываем отчётом о розничных продажах.
Лог = "";
Орг = Справочники.Организации.Выбрать(); Орг.Следующий(); Орг = Орг.Ссылка;
Магазин = Справочники.СтруктурныеЕдиницы.НайтиПоНаименованию("Модель магазин");
Товар = Справочники.Номенклатура.НайтиПоНаименованию("Товар А");
Материал = Справочники.Номенклатура.НайтиПоНаименованию("Материал Б");
Шт = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию("шт");
Х1 = Справочники.ХарактеристикиНоменклатуры.НайтиПоНаименованию("Вариант 1", , , Товар);
ВЦРозн = Справочники.ВидыЦен.НайтиПоНаименованию("Модель розница");
БезНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС");
Валюта = Константы.НациональнаяВалюта.Получить();
Д0 = НачалоДня(ТекущаяДатаСеанса());

// Способы оплаты: тип «Эквайринг», без подключения оборудования
СО = Новый Структура;
Для Каждого Имя Из СтрРазделить("Модель карта;Модель QR", ";") Цикл
	С = Справочники.СпособыОплаты.НайтиПоНаименованию(Имя);
	Если С.Пустая() Тогда
		О = Справочники.СпособыОплаты.СоздатьЭлемент(); О.Заполнить(Неопределено); О.Наименование = Имя; О.Организация = Орг;
		О.Тип = Перечисления.ТипыСпособовОплат.Эквайринг; О.ИспользоватьБезПодключенияОборудования = Истина; О.Записать(); С = О.Ссылка;
	КонецЕсли;
	СО.Вставить(?(СтрНайти(Имя, "QR") > 0, "QR", "Карта"), С);
КонецЦикла;

// Касса ККМ магазина — автономная (в рабочей базе здесь будет онлайн-касса)
Касса = Справочники.КассыККМ.НайтиПоНаименованию("Модель касса магазина");
Если Касса.Пустая() Тогда
	О = Справочники.КассыККМ.СоздатьЭлемент(); О.Заполнить(Неопределено); О.Владелец = Орг; О.Наименование = "Модель касса магазина";
	О.ТипКассы = Перечисления.ТипыКассККМ.АвтономнаяККМ; О.СтруктурнаяЕдиница = Магазин; О.ВалютаДенежныхСредств = Валюта; О.ИспользоватьБезПодключенияОборудования = Истина;
	О.Записать(); Касса = О.Ссылка;
КонецЕсли;

// Отчёт о розничных продажах: 3 шт товара + 2 шт материала; карта 1500, QR 1000, остальное наличными
Попытка
	Д = Документы.ОтчетОРозничныхПродажах.СоздатьДокумент(); Д.Дата = Д0 + 20*3600; Д.Заполнить(Неопределено);
	Д.Организация = Орг; Д.КассаККМ = Касса; Д.СтруктурнаяЕдиница = Магазин; Д.ВидЦен = ВЦРозн; Д.ВалютаДокумента = Валюта; Д.СуммаВключаетНДС = Истина;
	Д.СтатусКассовойСмены = Перечисления.СтатусыОтчетаОРозничныхПродажах.Закрыта; Д.НачалоКассовойСмены = Д0 + 9*3600; Д.ОкончаниеКассовойСмены = Д.Дата;
	С = Д.Запасы.Добавить(); С.Номенклатура = Товар; С.Характеристика = Х1; С.ЕдиницаИзмерения = Шт; С.Количество = 3; С.Цена = 1200;
	С = Д.Запасы.Добавить(); С.Номенклатура = Материал; С.ЕдиницаИзмерения = Шт; С.Количество = 2; С.Цена = 300;
	Для Каждого С Из Д.Запасы Цикл С.Сумма = С.Количество * С.Цена; С.Всего = С.Сумма; С.СтавкаНДС = БезНДС; КонецЦикла;
	Д.СуммаДокумента = Д.Запасы.Итог("Всего");
	Для Каждого Ст Из СтрРазделить("Карта|1500;QR|1000", ";") Цикл
		Ч = СтрРазделить(Ст, "|"); О = Д.БезналичнаяОплата.Добавить();
		О.ВидОплаты = Перечисления.ВидыБезналичныхОплат.БанковскаяКарта; О.ЭквайринговыйТерминал = СО[Ч[0]]; О.Сумма = Число(Ч[1]);
	КонецЦикла;
	Д.Записать(РежимЗаписиДокумента.Проведение);
	Лог = Лог + "Смена: проведено " + Д.Номер + " на " + Д.СуммаДокумента + " (карта 1500, QR 1000, наличные " + (Д.СуммаДокумента - 2500) + ")" + Символы.ПС;
Исключение Лог = Лог + "Смена: ОШИБКА " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС; КонецПопытки;
Для Каждого Сообщ Из ПолучитьСообщенияПользователю(Истина) Цикл Лог = Лог + "   сообщение: " + Сообщ.Текст + Символы.ПС; КонецЦикла;

З = Новый Запрос("ВЫБРАТЬ Т.Номенклатура КАК Н, Т.Характеристика КАК Х, Т.КоличествоОстаток КАК К ИЗ РегистрНакопления.Запасы.Остатки(, СтруктурнаяЕдиница = &С) КАК Т"); З.УстановитьПараметр("С", Магазин);
Для Каждого С Из З.Выполнить().Выгрузить() Цикл Лог = Лог + "   остаток магазин: " + С.Н + " " + С.Х + " = " + С.К + Символы.ПС; КонецЦикла;
Результат = Лог;
