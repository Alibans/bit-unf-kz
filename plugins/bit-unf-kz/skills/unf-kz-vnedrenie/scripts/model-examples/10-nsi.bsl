// Модель: справочники. Склад и магазин, виды цен, товар с характеристиками и упаковкой, материал,
// покупатели опт/розница с договорами (вид цен в договоре), поставщик. Счета учёта копируются из демо-образца.
// Имена — примерные, заменить на данные клиента. Повторный запуск не создаёт дублей.
Лог = "";
Орг = Справочники.Организации.Выбрать(); Орг.Следующий(); Орг = Орг.Ссылка;   // первая организация демобазы
Шт = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию("шт");
Лог = Лог + "Организация: " + Орг + Символы.ПС;

// Виды цен — копии существующего статического вида цен
З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.ВидыЦен ГДЕ ТипВидаЦен = ЗНАЧЕНИЕ(Перечисление.ТипыВидовЦен.Статический) И НЕ ПометкаУдаления");
Образец = З.Выполнить().Выгрузить()[0].Ссылка;
ВЦ = Новый Структура;
Для Каждого ИмяВЦ Из СтрРазделить("Модель опт,Модель розница", ",") Цикл
	Ссылка = Справочники.ВидыЦен.НайтиПоНаименованию(ИмяВЦ);
	Если Ссылка.Пустая() Тогда О = Образец.Скопировать(); О.Наименование = ИмяВЦ; О.Записать(); Ссылка = О.Ссылка; КонецЕсли;
	ВЦ.Вставить(?(СтрНайти(ИмяВЦ, "опт") > 0, "Опт", "Розница"), Ссылка);
КонецЦикла;

// Склад (тип Склад) и магазин (тип Розница). Счета учёта — с демо-структурной единицы того же типа
Склады = Новый Структура;
Для Каждого Опис Из СтрРазделить("Склад|Модель склад;Розница|Модель магазин", ";") Цикл
	Ч = СтрРазделить(Опис, "|"); Тип = Перечисления.ТипыСтруктурныхЕдиниц[Ч[0]];
	С = Справочники.СтруктурныеЕдиницы.НайтиПоНаименованию(Ч[1]);
	Если С.Пустая() Тогда
		О = Справочники.СтруктурныеЕдиницы.СоздатьЭлемент(); О.Наименование = Ч[1]; О.ТипСтруктурнойЕдиницы = Тип; О.Организация = Орг;
		Если Ч[0] = "Розница" Тогда
			О.РозничныйВидЦен = ВЦ.Розница;
			ЗО = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.СтруктурныеЕдиницы ГДЕ ТипСтруктурнойЕдиницы = &Т И Наименование <> &Н"); ЗО.УстановитьПараметр("Т", Тип); ЗО.УстановитьПараметр("Н", Ч[1]);
			В = ЗО.Выполнить().Выгрузить();
			Если В.Количество() > 0 Тогда О.СчетУчетаВРознице = В[0].Ссылка.СчетУчетаВРознице; О.СчетУчетаНаценки = В[0].Ссылка.СчетУчетаНаценки; КонецЕсли;
		КонецЕсли;
		О.Записать(); С = О.Ссылка;
	КонецЕсли;
	Склады.Вставить(Ч[0], С);
КонецЦикла;

// Номенклатура. Без счетов учёта приходная накладная не проводится («Не заполнен счет дебета») — копируем с демо-товара
З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Номенклатура ГДЕ ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Запас) И НЕ ЭтоГруппа И СчетУчетаЗапасов <> ЗНАЧЕНИЕ(ПланСчетов.Управленческий.ПустаяСсылка)");
ОбрН = З.Выполнить().Выгрузить()[0].Ссылка;
ПоляСчетов = "СчетУчетаЗапасов,СчетУчетаЗатрат,СчетУчетаДоходов,МетодОценки,СпособПополнения,ВидСтавкиНДС,КатегорияНоменклатуры,НаправлениеДеятельности";
Для Каждого Опис Из СтрРазделить("Товар А|1;Материал Б|0", ";") Цикл
	Ч = СтрРазделить(Опис, "|");
	Н = Справочники.Номенклатура.НайтиПоНаименованию(Ч[0]);
	Если Н.Пустая() Тогда
		О = Справочники.Номенклатура.СоздатьЭлемент(); О.Заполнить(Неопределено);
		О.Наименование = Ч[0]; О.НаименованиеПолное = Ч[0]; О.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас;
		О.ЕдиницаИзмерения = Шт; О.ИспользоватьХарактеристики = (Ч[1] = "1");
		Для Каждого П Из СтрРазделить(ПоляСчетов, ",") Цикл Если Не ЗначениеЗаполнено(О[П]) Тогда О[П] = ОбрН[П]; КонецЕсли; КонецЦикла;
		О.Записать();
	КонецЕсли;
КонецЦикла;
Товар = Справочники.Номенклатура.НайтиПоНаименованию("Товар А");

// Упаковка: коробка = 10 шт (остатки всегда в базовой единице — шт)
З = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.ЕдиницыИзмерения ГДЕ Владелец = &В И Наименование = ""коробка (10 шт)"""); З.УстановитьПараметр("В", Товар);
Если З.Выполнить().Пустой() Тогда
	О = Справочники.ЕдиницыИзмерения.СоздатьЭлемент(); О.Владелец = Товар; О.Наименование = "коробка (10 шт)"; О.Коэффициент = 10; О.ЕдиницаИзмеренияВладельца = Шт; О.Записать();
КонецЕсли;

// Характеристики
Для Каждого Имя Из СтрРазделить("Вариант 1;Вариант 2", ";") Цикл
	З = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.ХарактеристикиНоменклатуры ГДЕ Владелец = &В И Наименование = &Н"); З.УстановитьПараметр("В", Товар); З.УстановитьПараметр("Н", Имя);
	Если З.Выполнить().Пустой() Тогда О = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент(); О.Владелец = Товар; О.Наименование = Имя; О.НаименованиеДляПечати = "Товар А " + Имя; О.Записать(); КонецЕсли;
КонецЦикла;

// Контрагенты. Договор программа создаёт сама при записи контрагента — вид цен в нём выставляем отдельно
Для Каждого Опис Из СтрРазделить("Модель покупатель опт|Опт;Модель поставщик|", ";") Цикл
	Ч = СтрРазделить(Опис, "|"); Покупатель = (Ч[1] <> "");
	К = Справочники.Контрагенты.НайтиПоНаименованию(Ч[0], Истина);
	Если К.Пустая() Тогда
		О = Справочники.Контрагенты.СоздатьЭлемент(); О.Заполнить(Неопределено); О.Наименование = Ч[0]; О.НаименованиеПолное = Ч[0];
		О.ЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
		О.Покупатель = Покупатель; О.Поставщик = Не Покупатель; О.Записать(); К = О.Ссылка;
	КонецЕсли;
	З = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.ДоговорыКонтрагентов ГДЕ Владелец = &В"); З.УстановитьПараметр("В", К);
	В = З.Выполнить().Выгрузить();
	Если В.Количество() = 0 Тогда
		О = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент(); О.Заполнить(Неопределено); О.Владелец = К; О.Организация = Орг; О.Наименование = "Основной договор";
		О.ВидДоговора = ?(Покупатель, Перечисления.ВидыДоговоров.СПокупателем, Перечисления.ВидыДоговоров.СПоставщиком);
	Иначе
		О = В[0].Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Если Покупатель Тогда О.ВидЦен = ВЦ[Ч[1]]; КонецЕсли;
	О.Записать();
	Лог = Лог + Ч[0] + ": договор " + О.Ссылка + ?(Покупатель, ", вид цен " + О.ВидЦен, "") + Символы.ПС;
КонецЦикла;

Лог = Лог + "Склады: " + Склады.Склад + ", " + Склады.Розница + "; товар " + Товар + Символы.ПС;
Результат = Лог;
