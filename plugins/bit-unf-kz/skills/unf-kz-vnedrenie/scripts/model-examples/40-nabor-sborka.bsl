// Модель: комплекты. Два способа:
//  а) набор — собирают при покупателе: товар с флажком «Это набор» и составом; в чеке состав можно поменять,
//     списывается по фактическому составу; работает на складе типа «Розница»;
//  б) сборка заранее — спецификация + документ «Сборка запасов». На складе типа «Розница» сборка НЕ проводится
//     («не хватает остатка по учету запасов и затрат»), поэтому собираем на складе типа «Склад».
Лог = "";
Орг = Справочники.Организации.Выбрать(); Орг.Следующий(); Орг = Орг.Ссылка;
Склад = Справочники.СтруктурныеЕдиницы.НайтиПоНаименованию("Модель склад");
Магазин = Справочники.СтруктурныеЕдиницы.НайтиПоНаименованию("Модель магазин");
Товар = Справочники.Номенклатура.НайтиПоНаименованию("Товар А");
Материал = Справочники.Номенклатура.НайтиПоНаименованию("Материал Б");
Шт = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию("шт");
Х1 = Справочники.ХарактеристикиНоменклатуры.НайтиПоНаименованию("Вариант 1", , , Товар);
ВЦРозн = Справочники.ВидыЦен.НайтиПоНаименованию("Модель розница");
БезНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС");
Касса = Справочники.КассыККМ.НайтиПоНаименованию("Модель касса магазина");
Валюта = Константы.НациональнаяВалюта.Получить();
Д0 = НачалоДня(ТекущаяДатаСеанса());
ПоляСчетов = "СчетУчетаЗапасов,СчетУчетаЗатрат,СчетУчетаДоходов,МетодОценки,СпособПополнения,ВидСтавкиНДС,КатегорияНоменклатуры,НаправлениеДеятельности";

// а) Набор: 2 шт товара + 1 материал
Набор = Справочники.Номенклатура.НайтиПоНаименованию("Модель набор");
Если Набор.Пустая() Тогда
	О = Справочники.Номенклатура.СоздатьЭлемент(); О.Заполнить(Неопределено); О.Наименование = "Модель набор"; О.НаименованиеПолное = О.Наименование;
	О.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас; О.ЕдиницаИзмерения = Шт; О.ЭтоНабор = Истина;
	О.СпособРасчетаЦеныНабора = Перечисления.СпособыРасчетаЦеныНабора.СкладыватьИзЦенКомплектующих;
	О.ВариантПечатиНабора = Перечисления.ВариантыПечатиНаборов.ТолькоНабор;
	О.Записать(); Набор = О.Ссылка;
	НЗ = РегистрыСведений.СоставНаборов.СоздатьНаборЗаписей(); НЗ.Отбор.НоменклатураНабора.Установить(Набор);
	З = НЗ.Добавить(); З.НоменклатураНабора = Набор; З.Номенклатура = Товар; З.Характеристика = Х1; З.ЕдиницаИзмерения = Шт; З.Количество = 2; З.Порядок = 1; З.Общий = Истина;
	З = НЗ.Добавить(); З.НоменклатураНабора = Набор; З.Номенклатура = Материал; З.ЕдиницаИзмерения = Шт; З.Количество = 1; З.Порядок = 2; З.Общий = Истина;
	НЗ.Записать();
КонецЕсли;
// Продажа набора с изменённым составом (3 шт товара вместо 2): строки состава с заполненной НоменклатураНабора
Попытка
	Д = Документы.ОтчетОРозничныхПродажах.СоздатьДокумент(); Д.Дата = Д0 + 20*3600 + 1200; Д.Заполнить(Неопределено);
	Д.Организация = Орг; Д.КассаККМ = Касса; Д.СтруктурнаяЕдиница = Магазин; Д.ВидЦен = ВЦРозн; Д.ВалютаДокумента = Валюта; Д.СуммаВключаетНДС = Истина;
	Д.СтатусКассовойСмены = Перечисления.СтатусыОтчетаОРозничныхПродажах.Закрыта; Д.НачалоКассовойСмены = Д0 + 20*3600 + 600; Д.ОкончаниеКассовойСмены = Д.Дата;
	С = Д.Запасы.Добавить(); С.Номенклатура = Товар; С.Характеристика = Х1; С.НоменклатураНабора = Набор; С.ЕдиницаИзмерения = Шт; С.Количество = 3; С.Цена = 1200;
	С = Д.Запасы.Добавить(); С.Номенклатура = Материал; С.НоменклатураНабора = Набор; С.ЕдиницаИзмерения = Шт; С.Количество = 1; С.Цена = 300;
	Для Каждого С Из Д.Запасы Цикл С.Сумма = С.Количество * С.Цена; С.Всего = С.Сумма; С.СтавкаНДС = БезНДС; КонецЦикла;
	Д.СуммаДокумента = Д.Запасы.Итог("Всего");
	Д.Записать(РежимЗаписиДокумента.Проведение); Лог = Лог + "а) Продажа набора: проведено " + Д.Номер + " на " + Д.СуммаДокумента + Символы.ПС;
Исключение Лог = Лог + "а) ОШИБКА " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС; КонецПопытки;

// б) Сборка заранее на складе: изделие = 2 шт товара + 1 материал
Изделие = Справочники.Номенклатура.НайтиПоНаименованию("Модель изделие");
Если Изделие.Пустая() Тогда
	ОбрН = Товар;
	О = Справочники.Номенклатура.СоздатьЭлемент(); О.Заполнить(Неопределено); О.Наименование = "Модель изделие"; О.НаименованиеПолное = О.Наименование;
	О.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Запас; О.ЕдиницаИзмерения = Шт;
	Для Каждого П Из СтрРазделить(ПоляСчетов, ",") Цикл Если Не ЗначениеЗаполнено(О[П]) Тогда О[П] = ОбрН[П]; КонецЕсли; КонецЦикла;
	О.Записать(); Изделие = О.Ссылка;
КонецЕсли;
Попытка
	З = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Спецификации ГДЕ Владелец = &В"); З.УстановитьПараметр("В", Изделие); В = З.Выполнить().Выгрузить();
	Если В.Количество() = 0 Тогда
		Сп = Справочники.Спецификации.СоздатьЭлемент(); Сп.Владелец = Изделие; Сп.Наименование = "Модель спецификация";
		С = Сп.Состав.Добавить(); С.ТипСтрокиСостава = Перечисления.ТипыСтрокСоставаСпецификации.Материал; С.Номенклатура = Товар; С.Характеристика = Х1; С.ЕдиницаИзмерения = Шт; С.Количество = 2; С.КоличествоПродукции = 1;
		С = Сп.Состав.Добавить(); С.ТипСтрокиСостава = Перечисления.ТипыСтрокСоставаСпецификации.Материал; С.Номенклатура = Материал; С.ЕдиницаИзмерения = Шт; С.Количество = 1; С.КоличествоПродукции = 1;
		Сп.Записать(); Спец = Сп.Ссылка;
	Иначе Спец = В[0].Ссылка; КонецЕсли;
	Д = Документы.СборкаЗапасов.СоздатьДокумент(); Д.Дата = Д0 + 15*3600; Д.Заполнить(Неопределено);
	Д.ВидОперации = Перечисления.ВидыОперацийСборкаЗапасов.Сборка; Д.Организация = Орг;
	Д.СтруктурнаяЕдиница = Склад; Д.СтруктурнаяЕдиницаЗапасов = Склад; Д.СтруктурнаяЕдиницаПродукции = Склад;
	П = Д.Продукция.Добавить(); П.Номенклатура = Изделие; П.ЕдиницаИзмерения = Шт; П.Количество = 2; П.Спецификация = Спец; П.КлючСвязи = 1;
	С = Д.Запасы.Добавить(); С.Номенклатура = Товар; С.Характеристика = Х1; С.ЕдиницаИзмерения = Шт; С.Количество = 4; С.Спецификация = Спец; С.КлючСвязи = 1;
	С = Д.Запасы.Добавить(); С.Номенклатура = Материал; С.ЕдиницаИзмерения = Шт; С.Количество = 2; С.Спецификация = Спец; С.КлючСвязи = 1;
	Д.Записать(РежимЗаписиДокумента.Проведение); Лог = Лог + "б) Сборка на складе: проведено " + Д.Номер + Символы.ПС;
Исключение Лог = Лог + "б) ОШИБКА " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС; КонецПопытки;
Для Каждого Сообщ Из ПолучитьСообщенияПользователю(Истина) Цикл Лог = Лог + "   сообщение: " + Сообщ.Текст + Символы.ПС; КонецЦикла;

З = Новый Запрос("ВЫБРАТЬ Т.СтруктурнаяЕдиница КАК Склад, Т.Номенклатура КАК Н, Т.КоличествоОстаток КАК К ИЗ РегистрНакопления.Запасы.Остатки(, Номенклатура В (&Н)) КАК Т");
Н = Новый Массив; Н.Добавить(Товар); Н.Добавить(Материал); Н.Добавить(Изделие); З.УстановитьПараметр("Н", Н);
Для Каждого С Из З.Выполнить().Выгрузить() Цикл Лог = Лог + "   остаток: " + С.Склад + " | " + С.Н + " = " + С.К + Символы.ПС; КонецЦикла;
Результат = Лог;
